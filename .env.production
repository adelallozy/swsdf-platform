VITE_API_BASE_URL=https://swsdf.sa/api/
VITE_WEB_BASE_URL="https://swsdf.sa/"
VITE_FILES_BASE_URL="/"
VITE_MEDIA_BASE_URL="/"

VITE_ANNUAL_REPORT_LINK="https://swsdf.sa/documents/annual-report-2023.pdf"
VITE_DEFAULT_LOCALE="ar"

# Auth endpoints read directly by src/v3/composables/useAuth.js — without
# these the production build signs in against "undefined" URLs.
VITE_API_URL=https://swsdf.sa/api/
VITE_AUTHENTICATOR_SIGN_IN=users/login
VITE_AUTHENTICATOR_SIGN_OUT=users/logout
VITE_AUTHENTICATOR_VERIFY_TOKEN=users/verify-token
