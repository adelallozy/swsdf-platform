VITE_RFPS_OFFER_ATTACH_FILE=rfps/{id}/offer/files
VITE_RFPS_OFFER_REMOVE_FILE=rfps/{id}/offer/files/{fileRowId}/remove
VITE_RFPS_OFFER_SUBMIT=rfps/{id}/offer/submit
VITE_RFPS_OFFER_RECALL=rfps/{id}/offer/recall
VITE_GMAP_KEY="AIzaSyBiC8FdQjTmsRU8jw04O0FTRtbJ-rgrrPs"  # ✓ Recommended

